<Window x:Class="CtdoShotWin.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ctdoshot - Editor" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0" Background="#2B2B2B" Padding="10,6" BorderBrush="#3D3D3D" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="📋 Copy" Margin="0,0,6,0" Padding="10,4" Click="CopyButton_Click"/>
                <Button Content="💾 Save" Margin="0,0,6,0" Padding="10,4" Click="SaveButton_Click"/>
                <Button Content="🔍 OCR" Margin="0,0,6,0" Padding="10,4" Click="OcrButton_Click"/>
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,0"/>
                <Button Content="↗️ Arrow" Margin="0,0,6,0" Padding="8,4" Click="Tool_Click" Tag="Arrow"/>
                <Button Content="🔲 Rect" Margin="0,0,6,0" Padding="8,4" Click="Tool_Click" Tag="Rect"/>
                <Button Content="💬 Text" Margin="0,0,6,0" Padding="8,4" Click="Tool_Click" Tag="Text"/>
                <Button Content="🔢 Step" Margin="0,0,6,0" Padding="8,4" Click="Tool_Click" Tag="Step"/>
            </StackPanel>
        </Border>

        <!-- Image & Annotation Canvas -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="CanvasGrid">
                <Image x:Name="CapturedImage" Stretch="None"/>
                <Canvas x:Name="DrawingCanvas" Background="Transparent"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
